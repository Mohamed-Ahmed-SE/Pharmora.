# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pharmora?schema=public

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary - keep API secret server-side only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional public Cloudinary cloud name if client-side transformations need it
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
