# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEX_SITE=false

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pharmora?schema=public

# Better Auth (generate a unique 32+ character secret for each environment)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary — secrets are server-only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
